# ==============================================================================
# Telegram Digital Product Delivery Bot Configuration
# ==============================================================================

# Telegram Bot Token from @BotFather
BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ"

# Comma-separated list of Telegram User IDs who have administrative privileges
ADMIN_IDS="123456789,987654321"

# Required Telegram Channel for Force Subscription (Username e.g. @mychannel or ID e.g. -1001234567890)
CHANNEL_ID="@myvipchannel"

# Public invite URL or link to the required Telegram channel for users to join
CHANNEL_URL="https://t.me/myvipchannel"

# Database Connection URL:
# For SQLite (default, zero-setup async file database):
DATABASE_URL="sqlite+aiosqlite:///delivery_bot.db"

# For PostgreSQL (production high-throughput):
# DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/delivery_bot"

# Optional: Currency Symbol for reports & prices (e.g. $, €, £, AED)
CURRENCY_SYMBOL="$"

# AI Studio App Hosting URL (automatically populated in AI Studio)
APP_URL="MY_APP_URL"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
